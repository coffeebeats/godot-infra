# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Third party-related ignores
thirdparty/moltenvk/*
!thirdparty/moltenvk/.gitkeep

# Testing-related ignores (see "Testing the toolchain end to end" in README.md)
.godot-editor/
.scons/
build/
dist/
godot/
# Everything the editor generates inside the sample project; only its sources are tracked.
tests/project/*
!tests/project/.godot-version
!tests/project/export_presets.cfg
!tests/project/main.tscn
!tests/project/project.godot

# IDE-related ignores
.vscode/*

# Coding agent-related files
.claude/*
!.claude/skills

# Local image-build validation logs (see .claude/skills/upgrade-godot/references/build-validation.md)
.build-logs/
