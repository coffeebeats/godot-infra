# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Third party-related ignores
thirdparty/moltenvk/*
!thirdparty/moltenvk/.gitkeep

# Testing-related ignores (see "Testing the toolchain end to end" in README.md)
.godot-editor/
.scons/
/build/
/dist/
/godot/
# What a local export writes into the sample project; '.godot/' is covered above.
/tests/project/Game.*

# Python-related ignores
__pycache__/

# Python tooling
.venv/
.ruff_cache/

# IDE-related ignores
.vscode/*
!.vscode/extensions.json

# Coding agent-related files
.claude/*
!.claude/skills

# Local image-build validation logs (see .claude/skills/upgrade-godot/references/build-validation.md)
.build-logs/
