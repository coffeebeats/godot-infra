; Configures the checker for this case: an exclusion under `[all]` and one under a single
; rule, an extension that never loads, and the `logging`, `resource-loader` and
; `disable-3d` rules turned on.

[all]

excludes=["res://scratch/*"]
extensions={"res://absent.gdextension": ["AbsentApi"]}

[disable-3d]

disallow_3d_classes=true
scripts_3d=["res://disable-3d/only_3d/*", "res://*_3d.gd"]

[logging]

disallow_engine_output=true

[nodepath]

excludes=["res://nodepath/excluded.tscn"]

[preload]

excludes=["res://disable-3d/static_load.gd"]

[resource-loader]

allow=["res://resource-loader/loader.gd"]
excludes=["res://disable-3d/*", "res://preload/*", "res://self-preload/*"]
