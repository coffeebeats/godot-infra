; Configures the checker for this case: an exclusion under `[all]` and one under each
; of two rules, an extension that never loads, and the `logging` rule turned on.

[all]

excludes=["res://scratch/*"]
extensions={"res://absent.gdextension": ["AbsentApi"]}

[layer-copy]

excludes=["res://layer-copy/kept_excluded.tres"]

[logging]

disallow_engine_output=true

[nodepath]

excludes=["res://nodepath/excluded.tscn"]
